# Example environment variables (do NOT commit secrets)
# Copy this file to `.env.local` and fill with your values.
GEMINI_API_KEY=
# If you need the key in client-side code (Vite), also add a VITE_ prefixed var
# Warning: exposing secrets to client-side code is a security risk.
VITE_GEMINI_API_KEY=

# Example for other environment variables
# NODE_ENV=production